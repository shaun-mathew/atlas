    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
